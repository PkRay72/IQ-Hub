<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>AI Generate Questions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<div class="container mt-4" style="max-width:800px;">
    <h4>🤖 AI Generate Questions</h4>
    <p class="text-muted">Topic, subject aur exam category daalo, AI questions banayega. Pehle preview dikhega, aap check karke HOD ko bhejo.</p>

    <p th:if="${success}" class="alert alert-success" th:text="${success}"></p>
    <p th:if="${error}" class="alert alert-danger" th:text="${error}"></p>

    <form method="post" th:action="@{/teacher/questions/ai-generate}">
        <div class="mb-3">
            <label class="form-label">Topic</label>
            <input class="form-control" name="topic" placeholder="e.g. Binary Search Trees" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Subject</label>
            <input class="form-control" name="subject" placeholder="e.g. Data Structures" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Exam Category</label>
            <select class="form-select" name="category" required>
                <option th:each="c : ${categories}" th:value="${c}" th:text="${c}"></option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Difficulty</label>
            <select class="form-select" name="difficulty" required>
                <option th:each="d : ${difficulties}" th:value="${d}" th:text="${d}"></option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Number of Questions</label>
            <input type="number" class="form-control" name="count" min="1" max="10" value="5" required>
        </div>
        <button type="submit" class="btn btn-primary">Generate with AI</button>
        <a th:href="@{/teacher/dashboard}" class="btn btn-secondary">Cancel</a>
    </form>

    <div th:if="${previewQuestions != null and !#lists.isEmpty(previewQuestions)}" class="mt-4">
        <h5>Preview — HOD ko bhejne se pehle check kar lo</h5>
        <div class="card mb-2" th:each="q, iter : ${previewQuestions}">
            <div class="card-body">
                <p><b th:text="${iter.count} + '. ' + ${q.questionText}"></b></p>
                <p class="mb-1">A) <span th:text="${q.optionA}"></span> &nbsp; B) <span th:text="${q.optionB}"></span></p>
                <p class="mb-1">C) <span th:text="${q.optionC}"></span> &nbsp; D) <span th:text="${q.optionD}"></span></p>
                <p>Correct: <b th:text="${q.correctOption}"></b> | Subject: <span th:text="${q.subject}"></span> | Category: <span th:text="${q.examCategory}"></span> | Difficulty: <span th:text="${q.difficulty}"></span></p>
            </div>
        </div>

        <form method="post" th:action="@{/teacher/questions/ai-confirm}" class="d-inline">
            <button type="submit" class="btn btn-success">✓ Confirm & Send to HOD</button>
        </form>
        <form method="post" th:action="@{/teacher/questions/ai-discard}" class="d-inline">
            <button type="submit" class="btn btn-outline-danger">✗ Discard</button>
        </form>
    </div>
</div>
</body>
</html>