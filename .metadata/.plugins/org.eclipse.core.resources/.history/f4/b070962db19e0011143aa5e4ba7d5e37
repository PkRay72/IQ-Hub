<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Result Detail</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<div class="container mt-4">
    <h4 th:text="${result.test.title} + ' - Result'"></h4>
    <div class="alert alert-info">
        Score: <b th:text="${result.correctCount} + '/' + ${result.totalQuestions}"></b>
        (<span th:text="${#numbers.formatDecimal(result.score,1,1)}"></span>%) |
        Rating: <b th:text="${result.rating} + '/5'"></b>
        <span th:if="${result.autoSubmitted}" class="text-danger">
            | Auto-submitted (tab switches: <span th:text="${result.tabSwitchCount}"></span>)
        </span>
    </div>
    <div class="alert alert-warning" th:text="${result.reviewFeedback}"></div>

    <h5>Answer Review</h5>
    <div class="card mb-2" th:each="a : ${answers}">
        <div class="card-body">
            <p th:text="${a.question.questionText}"></p>
            <p>Your answer:
                <b th:text="${a.selectedOption} != null ? ${a.selectedOption} : 'Not answered'"
                   th:classappend="${a.correct} ? 'text-success' : 'text-danger'"></b>
                | Correct answer: <b th:text="${a.question.correctOption}"></b>
            </p>
        </div>
    </div>
    <a th:href="@{/student/results}" class="btn btn-secondary">Back to results</a>
</div>
</body>
</html>