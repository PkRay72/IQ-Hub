<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Notifications</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<div class="container mt-4">
    <h4>Notifications</h4>
    <a th:href="@{/teacher/dashboard}" class="btn btn-sm btn-secondary mb-3">Back</a>
    <ul class="list-group">
        <li class="list-group-item" th:each="n : ${notifications}">
            <div th:text="${n.message}"></div>
            <small class="text-muted" th:text="${n.createdAt}"></small>
        </li>
    </ul>
    <p th:if="${#lists.isEmpty(notifications)}">No notifications yet.</p>
</div>
</body>
</html>