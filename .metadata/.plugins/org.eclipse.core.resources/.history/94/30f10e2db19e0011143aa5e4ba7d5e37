<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Teacher Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<nav class="navbar navbar-dark bg-primary px-3">
    <span class="navbar-brand">IQHub - Teacher</span>
    <div>
        <a class="btn btn-sm btn-light me-2" th:href="@{/profile}">My Profile</a>
        <a class="btn btn-sm btn-light me-2" th:href="@{/teacher/my-tests}">My Tests / Results</a>
        <a class="btn btn-sm btn-light me-2" th:href="@{/teacher/notifications}">
            Notifications <span class="badge bg-danger" th:text="${unreadCount}" th:if="${unreadCount > 0}"></span>
        </a>
        <form th:action="@{/logout}" method="post" class="d-inline">
            <button class="btn btn-sm btn-outline-light">Logout</button>
        </form>
    </div>
</nav>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>My Questions</h4>
        <div>
            <a th:href="@{/teacher/questions/add}" class="btn btn-primary">+ Add Question</a>
            <a th:href="@{/teacher/questions/ai-generate}" class="btn btn-outline-success">🤖 AI Generate</a>
            <a th:href="@{/teacher/tests/create}" class="btn btn-outline-primary">Create Test</a>
        </div>
    </div>

    <form method="get" th:action="@{/teacher/dashboard}" class="row g-2 mb-3">
        <div class="col-auto">
            <select class="form-select" name="category" onchange="this.form.submit()">
                <option value="">All Categories</option>
                <option th:each="c : ${categories}" th:value="${c}" th:text="${c}"
                        th:selected="${selectedCategory != null and selectedCategory.name() == c.name()}"></option>
            </select>
        </div>
    </form>

    <table class="table table-bordered table-striped">
        <thead>
        <tr><th>#</th><th>Question</th><th>Subject</th><th>Category</th><th>Difficulty</th><th>Status</th><th>HOD Comment</th><th>Action</th></tr>
        </thead>
        <tbody>
        <tr th:each="q : ${questions}">
            <td th:text="${q.id}"></td>
            <td th:text="${q.questionText}"></td>
            <td th:text="${q.subject}"></td>
            <td th:text="${q.examCategory}"></td>
            <td th:text="${q.difficulty}"></td>
            <td>
                <span class="badge"
                      th:classappend="${q.status.name() == 'APPROVED'} ? 'bg-success' :
                                       (${q.status.name() == 'PENDING'} ? 'bg-warning text-dark' :
                                       (${q.status.name() == 'NEEDS_IMPROVEMENT'} ? 'bg-info text-dark' : 'bg-danger'))"
                      th:text="${q.status}"></span>
            </td>
            <td th:text="${q.reviewComment}"></td>
            <td>
                <a th:if="${q.status.name() == 'NEEDS_IMPROVEMENT'}"
                   th:href="@{/teacher/questions/edit/{id}(id=${q.id})}"
                   class="btn btn-sm btn-warning">Improve & Resubmit</a>
            </td>
        </tr>
        </tbody>
    </table>
    <p th:if="${#lists.isEmpty(questions)}" class="text-muted">Is category me koi question nahi hai.</p>
</div>
</body>
</html>