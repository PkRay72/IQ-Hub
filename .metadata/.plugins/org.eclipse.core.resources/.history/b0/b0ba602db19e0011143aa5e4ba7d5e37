<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Test Results</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<div class="container mt-4">
    <h4 th:text="${test.title} + ' - Student Results'"></h4>
    <a th:href="@{/teacher/my-tests}" class="btn btn-sm btn-secondary mb-3">Back</a>
    <table class="table table-bordered">
        <thead>
        <tr><th>Student ID</th><th>Student Name</th><th>Score</th><th>Rating</th><th>Tab Switches</th><th>Submitted At</th></tr>
        </thead>
        <tbody>
        <tr th:each="r : ${results}">
            <td th:text="${r.student.id}"></td>
            <td th:text="${r.student.fullName}"></td>
            <td th:text="${r.correctCount} + '/' + ${r.totalQuestions} + ' (' + ${#numbers.formatDecimal(r.score,1,1)} + '%)'"></td>
            <td th:text="${r.rating} + '/5'"></td>
            <td th:text="${r.tabSwitchCount}"></td>
            <td th:text="${r.submittedAt}"></td>
        </tr>
        </tbody>
    </table>
    <p th:if="${#lists.isEmpty(results)}">Abhi tak kisi student ne ye test attempt nahi kiya.</p>
</div>
</body>
</html>