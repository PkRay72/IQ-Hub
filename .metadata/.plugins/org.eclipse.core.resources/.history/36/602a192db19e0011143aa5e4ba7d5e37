<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title>Student Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" th:href="@{/css/style.css}">
</head>
<body>
<nav class="navbar navbar-dark bg-success px-3">
    <span class="navbar-brand">IQHub - Student</span>
    <div>
        <a class="btn btn-sm btn-light me-2" th:href="@{/profile}">My Profile</a>
        <a class="btn btn-sm btn-light me-2" th:href="@{/student/results}">My Results</a>
        <form th:action="@{/logout}" method="post" class="d-inline">
            <button class="btn btn-sm btn-outline-light">Logout</button>
        </form>
    </div>
</nav>
<div class="container mt-4">
    <h4>Available Tests</h4>
    <div class="card mb-2" th:each="t : ${tests}">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <h6 th:text="${t.title}"></h6>
                <small th:text="${t.subject} + ' | ' + ${t.durationMinutes} + ' minutes | ' + ${#lists.size(t.questions)} + ' questions'"></small>
            </div>
            <div th:with="existingResult=${resultService.getExistingResult(student, t)}">
                <a th:if="${existingResult.isEmpty()}"
                   th:href="@{/student/test/{id}/start(id=${t.id})}" class="btn btn-primary">Start Test</a>
                <a th:if="${existingResult.isPresent()}"
                   th:href="@{/student/result/{id}(id=${existingResult.get().id})}"
                   class="btn btn-outline-secondary">✓ Already Attempted — View Result</a>
            </div>
        </div>
    </div>
    <p th:if="${#lists.isEmpty(tests)}">Abhi koi test published nahi hai.</p>
</div>
</body>
</html>